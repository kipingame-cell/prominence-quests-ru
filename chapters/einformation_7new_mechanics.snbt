	quest_links: [ ]
	quests: [
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Все щиты имеют новую механику из мода &e&7Shield Overhaul."
				""
				"- &e&lУдар с &r&7одновременной блокировкой для выполнения удара щитом. &7Это оглушит цель на 1 секунду, если только это не босс."
			]
			icon: {
				Count: 1
				id: "minecraft:shield"
				tag: {
					Damage: 0
				}
			}
			id: "51595E88AF1F475E"
			rewards: [{
				id: "73FEF9863E4C5F38"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "7AAEF7553C3616AE"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eНовая защитная механика"
			x: 1.5d
			y: -2.5d
		}
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Боевая механика была изменена с помощью мода &e&7Better Combat."
				""
				"- &6&lОружие &r&7Каждое оружие имеет свою собственную анимацию атаки и время ее проведения."
				""
				"- &6&lКомбо-удары При &r&7последовательных атаках будут выполняться комбо-удары."
				""
				"- &6&lУдерживайте для атаки &r&7Вы можете удерживать кнопку атаки, чтобы продолжать атаковать непрерывно."
			]
			icon: {
				Count: 1
				id: "minecraft:netherite_sword"
				tag: {
					Damage: 0
				}
			}
			id: "6B8B4323E13AB3E9"
			rewards: [{
				id: "475CDA6694C41230"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "3589A9BB969BA94E"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eНовая боевая механика"
			x: -1.5d
			y: -2.5d
		}
		{
			description: [
				"&7В этом учебном пособии questline объясняется, как работает бой, начиная с измененной механики и заканчивая тем, как создать себя самому."
				""
				"&eХотя это руководство по началу игры, оно распространяется и на конечные сборки игры. По мере прохождения будут появляться новые задания."
				""
				"&7Большая часть этого квеста - просто чтение, &cпожалуйста, обязательно прочтите, &7если хотите по-настоящему разобраться в происходящем, так как это важная информация."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
			id: "6930C77988A640AF"
			shape: "hexagon"
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "4B87D5A81113B3B8"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eКак работают бой и развитие снаряжения?"
			x: 0.0d
			y: -3.0d
		}
		{
			dependencies: [
				"51595E88AF1F475E"
				"6B8B4323E13AB3E9"
			]
			description: [
				"&7В следующих руководствах вы узнаете, на что обратить внимание в зависимости от конкретных типов сборок. Это не полностью разработанные сборки, это просто рекомендации по выбору снаряжения в зависимости от вашего игрового процесса."
				""
				"&eПоказанная сложность относится как к тому, насколько сложно в нее играть, так и к тому, насколько сложно создать сборку &7(хотя сложность игрового процесса имеет больший приоритет)&7."
				""
				"&6Как работают уровни?"
				""
				"&7Уровень I: &eначальное снаряжение &8(Верхний мир)"
				"&eУровень II: &eранняя игра &8(после Нижнего мира)"
				"&6Уровень III: &eсередина игры &8(после Края)"
				"&cУровень IV: &eпоздняя игра &8(после получения артефактов)"
				"&dУровень V: &eфинальный этап&r &8(первозданное снаряжение)"
				""
				"&eЭта часть задания может оказаться сложной! Чтобы узнать больше о получении книг по навыкам, пожалуйста, ознакомьтесь с заданием по заклинаниям."
				""
				"&6Полные руководства по конкретным сборкам можно найти в официальной вики!"
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "tiered:textures/gui/anvil_tab_icon.png"
				}
			}
			id: "61C05AE305488DF5"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "317E2316EEFC9AAE"
					table_id: 3737891217858354553L
					type: "choice"
				}
				{
					exclude_from_claim_all: true
					id: "44F8556F47340107"
					table_id: 5228678659320885423L
					type: "choice"
				}
				{
					id: "3B5501E046C999AE"
					item: {
						Count: 1
						id: "prominent:loot_box"
						tag: {
							lottery_id: "prominent:healing_lottery"
						}
					}
					type: "item"
				}
			]
			shape: "none"
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "22AD24EC0678727A"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eКак выбрать снаряжение?"
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Характеристики, также известные как атрибуты, представляют собой набор чисел, связанных с вашим персонажем, которые позволяют масштабировать другие характеристики."
				""
				"&7Например, скорость определяет, насколько быстро вы атакуете, в то время как здоровье определяет, сколько у вас здоровья и т.д."
				""
				"&7В следующих заданиях будут описаны основные характеристики и то, насколько каждое из них важно для конкретного использования."
				""
				"&eХарактеристики - это основная часть вашего снаряжения, важно, чтобы вы понимали, какие характеристики вам нужны, а какие нет, в зависимости от того, как вы хотите создать их самостоятельно."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "fwaystones:item/empty_waystone_scroll"
				}
			}
			id: "44D9519561FE2D1B"
			shape: "hexagon"
			size: 1.0d
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "30BD1DF965773137"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eКак работают характеристики?"
			x: 0.0d
			y: -4.5d
		}
		{
			dependencies: ["44D9519561FE2D1B"]
			description: [
				"&eОсновные характеристики в той или иной степени нужны каждому."
				""
				"&7Либо потому, что у вас уже есть количество по умолчанию (например, здоровье), либо потому, что любая часть снаряжения будет давать эти характеристики (например, скорость и броня)."
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "minecraft:textures/gui/sprites/hud/heart/frozen_hardcore_full.png"
				}
			}
			id: "3F794C7D175F14C0"
			shape: "hexagon"
			size: 1.1d
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "6F23FA02C5CA4AD2"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eОсновные характеристики"
			x: -1.5d
			y: -5.5d
		}
		{
			dependencies: ["44D9519561FE2D1B"]
			description: [
				"&eХарактеристики, предназначенные для дальнего боя."
				""
				"&7В то время как физический урон используется всеми, дальнобойщики предпочитают другую статистику в зависимости от того, какой путь они выбирают: Стрельба из &eлука &7(физическая дальнобойность) или использование &eзаклинаний &7(дальнобойная магия)."
				""
				"&7Магию можно применять и в ближнем бою, используя билды чародейского клинка."
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ranged_weapon:textures/mob_effect/damage.png"
				}
			}
			id: "479F0EDD5681A06D"
			shape: "hexagon"
			size: 1.1d
			subtitle: "&8[Нажмите, чтобы узнать больше]"
			tasks: [{
				id: "5C9AFBF0E99AE7AC"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&eХарактеристики дальнего боя и магии"
			x: 1.5d
			y: -5.5d
		}
		{
			dependencies: ["3F794C7D175F14C0"]
			description: [
				"&eСпешка повышает скорость физических атак."
				""
				"&7Вы быстрее атакуете и меняете оружие. Этот показатель также влияет на определённое оружие и предметы. Особенно важен для билдов разбойника и других билдов с быстрыми атаками."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"

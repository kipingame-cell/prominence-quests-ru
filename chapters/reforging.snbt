	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"&7Создавая или приобретая инструменты, броню или оружие, вы заметите, что они обладают определенным качеством."
				""
				"&7Эти качества варьируются от:"
				"&8- &fОбщий"
				"&8- &2Необычный"
				"&8- &3Редкий"
				"&8- &dЭпический"
				"&8- &6Легендарный"
				"&8- &cМифический"
				""
				"{@pagebreak}"
				""
				"&6Перековка &7- важная часть вашего собственного прогресса, поскольку она позволяет изменить редкость вашего предмета."
				""
				"&7Для этого вы можете найти вкладку \"&e&7Перековка\" на &eнаковальне&7. Вам потребуется:"
				""
				"&8- &eОсновной материал &8(Левая прорезь)"
				"&8- &eПредмет для перековки &8(средний слот)"
				"&8- &eМатериал для перековки &8(Правый паз)"
				""
				""
				"{@pagebreak}"
				""
				"&e&lМатериал основы &r&8(левая прорезь)"
				""
				"&7Базовый материал напрямую связан с предметом, который вы хотите перековать. Например, для изготовления &eСвященного жезла в качестве базового материала &7потребуется &e&7золотой слиток. Вы можете просмотреть необходимые материалы, наведя курсор на кнопку перековки после того, как поместите предмет в среднее поле."
				""
				""
				"{@pagebreak}"
				""
				"&e&lБазовый элемент &r&8(средний слот)"
				""
				"&7Базовый предмет - это предмет, редкость которого вы хотите изменить. Не все предметы можно перековать, только инструменты, оружие и доспехи."
				""
				""
				"{@pagebreak}"
				""
				"&e&lПерековать материал"
				""
				"&7Этот материал будет определять, до какого качества будет перекован ваш предмет, есть 3 уровня материалов, которые вы можете увидеть в следующих заданиях этой серии квестов."
				""
				""
				"{@pagebreak}"
				""
				"&a&lУвеличивая Ваши шансы"
				""
				"&7Дело не только в измельчении! Вы можете &eувеличить шансы на получение более качественных продуктов, если &7вам &aповезет&7! Предметы, которые приносят удачу пассивно, зелья удачи, безделушки, вино - получите их все!"
			]
			id: "3C95FD1F14D109CF"
			shape: "hexagon"
			subtitle: "&8[Нажмите, чтобы прочитать инструкции]"
			tasks: [{
				id: "71FAC91280FBBF9C"
				item: "minecraft:anvil"
				title: "Изготовьте наковальню"
				type: "item"
			}]
			title: "&eЧто такое перековка?"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3C95FD1F14D109CF"]
			description: [
				""
				"&7Кусок &nизвестняка - &r&7это первый слой материалов для перековки."
				""
				"&7Его можно найти в Потустороннем &aмире&7, &eизготовив &74 &fизвестняковых блока &r&8(по 4 штуки) &7или 4 &fдиоритовых блока &r&8(по 4 штуки)."
				""
				"&7Он может перековаться в следующие качества:"
				"&8- &fОбщий"
				"&8- &2Необычный"
				"&8- &3Редкий"
				"&8- &dЭпический"
			]
			id: "4D3F0D8217067D24"
			shape: "diamond"
			subtitle: "&8[Нажмите, чтобы прочитать инструкции]"
			tasks: [{
				id: "4593A7256861742B"
				item: "tiered:limestone_chunk"
				type: "item"
			}]
			title: "&6&lУровень I: &fИзвестняк"
			x: 0.0d
			y: 2.5d
		}
		{
			dependencies: ["4D3F0D8217067D24"]
			description: [
				""
				"&7Кусок &nпирита - &r&7это второй слой материалов для перековки."
				""
				"&7Его можно найти в &cПреисподней&7, &eизготовив &7из 4 кусков &6пиритной пыли &r&8(за 1 штуку) &7или вырезав из &eкамня &7&6древний обломок &r&7&8(за 4 куска) &7Его также можно &bизготовить из &r&7&eСветящегося камня&r."
				""
				"&8* Пиритная пыль может быть получена при добыче пиритной руды в нижних слоях"
				""
				"&7Он может перековаться в следующие качества:"
				"&8- &2Необычный"
				"&8- &3Редкий"
				"&8- &dЭпический"
				"&8- &6Легендарный"
			]
			id: "31388834855FB88E"
			shape: "diamond"
			subtitle: "&8[Нажмите, чтобы прочитать инструкции]"
			tasks: [{
				id: "23DAEBDBFD05AB7B"
				item: "tiered:pyrite_chunk"
				type: "item"
			}]
			title: "&6&lУровень II: &eПирит"

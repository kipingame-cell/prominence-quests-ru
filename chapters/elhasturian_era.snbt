	order_index: 3
	quest_links: [ ]
	quests: [
		{
			dependencies: ["04AF2E026BB918AE"]
			description: [
				"&cЗавершите все главы \"Вторжения Пустоты\", чтобы раскрыть сюжетную линию этого дополнения."
				""
				"&8Перевод с английского"
				""
				"{@pagebreak}"
				"&cЗавершите все главы Void's Invasion, чтобы разблокировать кампанию этого дополнения."
				""
				"&8Перевод с испанского"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "eldritch_end:textures/mob_effect/hastur_presence.png"
				}
			}
			id: "73DA5990952CEA35"
			rewards: [{
				advancement: "prominent:level_50"
				auto: "invisible"
				criterion: ""
				id: "1D56AC4A22CDB24A"
				title: "&eРазблокируйте 51-65 уровней"
				type: "advancement"
			}]
			shape: "diamond"
			size: 1.5d
			subtitle: "&8[Нажмите, чтобы прочитать инструкции]"
			tasks: [{
				advancement: "prominent:end_of_voids_invasion"
				criterion: ""
				id: "190537CB8ABEDC05"
				title: "&dЗавершите кампанию вторжения Пустоты"
				type: "advancement"
			}]
			title: "&eХастурианская эра"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["73DA5990952CEA35"]
			description: [
				"&7&oМного веков назад С'келлак сражался против сверхъестественных существ, победив и заключив в тюрьму изначальное существо К'Тулху."
				""
				"&7&oВ то время как его последователи бежали, цепи, сковывавшие его сводного брата, высокого монстра в капюшоне и со щупальцами, были разорваны. С'Келлак не смог остановить его побег, и целую вечность он его больше не видел."
				""
				"&8(1/2)"
				"{@pagebreak}"
				"&7&oДо сих пор, после попытки захвата власти оставшимися силами пустоты, все королевства оставались самыми слабыми из всех, какими они были."
				""
				"&e&oКороль в желтом вернулся и не остановится, пока все королевства не подчинятся его новому правлению."
				""
				"&8(2/2)"
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: "ftbquests:book"
			id: "579138B8DB19724C"
			shape: "diamond"
			size: 1.25d
			subtitle: "&8[Нажмите, чтобы прочитать историю]"
			tasks: [{
				id: "3E72FE8109B34FDF"
				title: "Продолжить"
				type: "checkmark"
			}]
			title: "&6&lГлава I: &e&lТень за горизонтом"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["579138B8DB19724C"]
			description: [
				"&8В послании говорится:"
				""
				"&7&o- Чемпион, это срочно."
				""
				"&7&oЯ подтвердил, что это он, изначальное существо всего нечестивого, известное как Хастур."
				""
				"&7&oЯ чувствую его присутствие рядом, нам нужно привести в готовность все наши средства защиты, Вааз может быть в опасности."
				""
				"&7&oПриезжай сюда, как только сможешь. Ты нужен нам, Огнерожденный."
				""
				"&7&oВам также следует зачаровать свое оружие с помощью \"Удара\", ведь последователи Хастура - нежить. Вы должны быть готовы к худшему.\""
			]

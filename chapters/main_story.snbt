	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: ["7023C0EC0A4686E2"]
			description: [
				"&eРекомендуемый уровень: 15"
				""
				"&7&o\"Рука\", некогда бдительный страж и первый глашатай Нижнего мира, теперь попала в темные объятия Пустоты. Став одним из глашатаев Бездны, она теперь угрожает уничтожением своему собственному царству."
				""
				"&7&oТы можешь обнаружить, что \"Рука\" заперта в монолитной тюрьме. Разбей ее глаз, и ты выпустишь на волю теперь уже испорченное существо."
				""
				"&eСовет: У &7этого босса сильные удары, и он может подстрелить вас, если играть на обычном или сложном уровне сложности! Старайтесь уворачиваться или создавать защитные зелья!"
				""
				"&8Перевод с английского"
				"{@pagebreak}"
				"&eРекомендуемый уровень: 15"
				""
				"&7&oПерчатка, когда-то служившая стражем и первым вестником Пустоты, теперь упала в темные объятия Пустоты. Порабощенный как один из его вестников, он угрожает разрушением своего собственного королевства, Нижнего мира."
				""
				"&7&oВы можете найти Руку запертой в монолитной тюрьме. Сломай ему глаз, и ты освободишь теперь испорченного зверя."
				""
				"&eСовет: У &7этого босса сильные атаки, которые могут убить вас одним ударом, если вы играете на нормальном или сложном уровне сложности! Попытайтесь уклониться от атак или приготовьте защитные зелья."
				""
				"&8Перевод с испанского"
			]

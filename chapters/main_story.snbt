			x: -12.204761904761916d
			y: 2.3214285714285765d
		}
		{
			dependencies: ["7CBAFED315D614C3"]
			dependency_requirement: "one_completed"
			description: [
				"&eРекомендуемый уровень: 10"
				"&cЛучше подходит для дальнего боя"
				""
				"&7&oДавно умершие души всех королей Королевства Лирелл были воскрешены и развращены неизвестной силой, теперь известной как один-единственный монстр по имени Ночной Лич."
				""
				"&7&oНочной лич обитает на поверхности Надземного мира. Ищите его в холодных биомах, в развалинах разрушенной башни."
				""
				"&7&oЧтобы найти это сооружение, используйте Звезды Душ, сброшенные немертвыми существами, которые приведут вас к башне."
				""
				"&eСовет: &7Это босс дальнего боя, используйте летающего коня, если вы боец ближнего боя, или лук в качестве дополнительного оружия!"
				""
				"&8Перевод с английского"
				"{@pagebreak}"
				"&eРекомендуемый уровень: 10"
				"&cРекомендуется для Лучников и магов."
				""
				"&7&oДуши давно умерших бывших королей Королевства Лай'релл были воскрешены и развращены неизвестной силой, в результате чего образовался большой монстр, ныне известный как Ночной Лич."
				""
				"&7&oВ самых холодных биомах, на вершине обломков большой разрушенной башни, они лежат в ловушке."
				""
				"&7&oЧтобы найти это сооружение, используйте Звезды Души, капли нежити, которые проведут вас к башне."
				""
				"&eСовет: &7Этот босс имеет ранг, используйте летающего скакуна, если вы играете в ближнем бою, или лук в качестве дополнительного оружия!"
				""
				"&8Перевод с испанского"
			]

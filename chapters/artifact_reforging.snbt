	quests: [
		{
			dependencies: ["45437B8E9AEEF2E5"]
			description: [
				"&6Требуется завершение первой &nглавы \"&r&6Вторжения Пустоты\"."
				""
				"&7Расплавленное ядро - это могущественный артефакт, добытый в недрах вулкана &cВааз&7."
				"&7С его помощью вы можете создавать мощное и уникальное артефактное оружие, обладающее особыми способностями и привязанное к вашей душе, что делает его доступным только для того, кто его выковал."
				""
				"&bЗаключенные в оболочку остатки &7можно использовать для ремонта и перековки этого оружия. Вам также следует приготовить &6укрепляющий катализатор, &7чтобы сделать его небьющимся."
			]
			icon: "prominent:molten_core"
			id: "6AD67E7C8CD78371"
			rewards: [
				{
					id: "5562501929CD8443"
					type: "xp_levels"
					xp_levels: 5
				}
				{
					count: 10

					item: "prominent:encased_remnant"
					type: "item"
				}
			]
			shape: "none"
			size: 1.5d
			subtitle: "&8[Нажмите, чтобы прочитать историю и инструкции]"
			tasks: [
				{
					id: "035441107821B3C1"
					item: "prominent:molten_core"

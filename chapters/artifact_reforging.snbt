				}
				{
					id: "56A625D024CDB2DE"
					item: "things:hardening_catalyst"
					title: "Сделайте твердеющий кристалл"
					type: "item"
				}
			]
			title: "&cС'келлак Forge"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: [
				"&eМожет быть выкован с использованием Эссенции Гнева и Пробужденного Меча Лича, а также Расплавленного Ядра."
				""
				""
				"&8Этот предмет является данью уважения игре World of Warcraft \"Ледяная скорбь\"."
			]
			id: "341DB238063321BF"
			shape: "hexagon"
			subtitle: "Проклятый меч, обладающий силой вечной зимы. Ледяная скорбь - это рунический артефакт, наполненный магией душевного холода. Легенда гласит, что тот, кто овладеет им, станет правителем рыцарей Смерти, королем-личом."
			tasks: [{
				id: "7F239D03EBB09534"
				item: {
					Count: 1
					id: "prominent:frostmourne"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: -2.0d
			y: -2.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: [
				"&eМожет быть выкован с использованием двух расплавленных кромок и расплавленной сердцевины."
				""
				""
				"&8Этот предмет - дань уважения Фиралату из World of Warcraft."
			]
			id: "6D1B83D633AB7558"
			shape: "hexagon"
			subtitle: "Смертоносное оружие огня души, оказывающее огромное сопротивление своему владельцу. Предназначено для танкования, но наносит большой урон огнем."
			tasks: [{
				id: "52D24DAEDFD19F9A"
				item: {
					Count: 1
					id: "prominent:fyralath"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: -3.0d
			y: 0.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: ["&eМожет быть выкован с использованием Демонической сущности и Хранителя душ, а также Расплавленного Ядра."]
			id: "5D03084D09D2A997"
			shape: "hexagon"
			subtitle: "&7Азхар был демоном, который был заключен в косу, выкованную С'Келлаком, что делало это оружие из огня души не союзником, будьте осторожны при его использовании, потому что оно попытается предать вас."
			tasks: [{
				id: "43F5AAA9405EE27D"
				item: {
					Count: 1
					id: "prominent:azhar"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			x: -2.5d
			y: 1.0d
		}
		{
			dependencies: ["6AD67E7C8CD78371"]
			description: ["&eМожет быть выкован с использованием Эссенции Славы и Звездного горна, а также Расплавленного ядра."]
			id: "1CE7763C1889255C"
			shape: "hexagon"
			subtitle: "Созданная из остатков умирающей звезды, Сверхновая - это астральное оружие, которое может наносить урон, используя все магические элементы, и уничтожать любые цели астральными разрядами."
			tasks: [{
				id: "6B6E9C04C7D69E89"
				item: {
					Count: 1
					id: "prominent:supernova"
					tag: {
						Damage: 0
